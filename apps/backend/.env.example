PORT=8000

# Optional. Raises GitHub's API limit from 60 to 5,000 requests/hour.
# A fine-grained token with no extra permissions is enough for public repos.
GITHUB_TOKEN=

# Comma-separated origins allowed to call the API.
CORS_ORIGIN=https://markforge.vercel.app,http://localhost:3000

# Free-tier repo -> README generations per IP per day.
FREE_GENERATIONS_PER_DAY=3

# Number of reverse-proxy hops in front of the API (needed for per-IP limits in production).
TRUST_PROXY=
