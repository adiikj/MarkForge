PORT=8000

# Optional. Raises GitHub's API limit from 60 to 5,000 requests/hour.
# A fine-grained token with no extra permissions is enough for public repos.
GITHUB_TOKEN=

# Comma-separated origins allowed to call the API.
CORS_ORIGIN=https://markforge.vercel.app,http://localhost:3000

# Free-tier repo -> README generations per IP per day.
FREE_GENERATIONS_PER_DAY=3

# Which proxies to trust for the client IP (per-IP limits for signed-out visitors).
# Default trusts private-network proxies only. Behind Vercel (the Next app proxies /api here), set 1.
TRUST_PROXY=

# AI-assisted README drafts (Groq). Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional. Check https://console.groq.com/docs/models for current ids.
GROQ_MODEL=llama-3.3-70b-versatile
# Optional: bytes of source code sent for context, and the output token cap.
AI_SOURCE_BYTES=20000
AI_MAX_OUTPUT_TOKENS=4096

# ---- Database (Prisma + PostgreSQL) ----
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/markforge?schema=public"

# ---- Auth ----
# Long random string: openssl rand -base64 48
ACCESS_TOKEN_SECRET=
# Public URL of the web app (used in email links and the GitHub OAuth callback).
APP_URL=http://localhost:3000
# Set to true to force Secure cookies outside production (e.g. HTTPS staging).
COOKIE_SECURE=
# Signed-in free accounts get more daily repo drafts than anonymous visitors.
FREE_ACCOUNT_GENERATIONS_PER_DAY=5

# GitHub OAuth App: https://github.com/settings/developers
# Authorization callback URL: <APP_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Email (Resend) ----
# Without a key, verification and reset links are printed to the server console.
RESEND_API_KEY=
EMAIL_FROM="MarkForge <onboarding@resend.dev>"
