# Where the MarkForge backend (apps/backend) runs. Next.js proxies /api/* to it,
# so the browser only ever talks to this app's own origin (first-party auth cookies).
BACKEND_URL=http://localhost:8000

# Optional: call a different API origin directly from the browser instead of the proxy.
# Leave unset for the proxy (required for login cookies to work across domains).
# NEXT_PUBLIC_API_URL=
